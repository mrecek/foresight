#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"

root = File.expand_path("..", __dir__)
expected_ruby, version_status = Open3.capture2e(File.join(root, "bin/ruby-version"))
abort expected_ruby unless version_status.success?
expected_ruby = expected_ruby.strip
dockerfile = File.read(File.join(root, "Dockerfile"))
abort "Dockerfile must not encode an OS package refresh epoch" if dockerfile.include?("OS_PATCH_EPOCH")
abort "Dockerfile must combine apt update and upgrade in the os-packages stage" unless
  dockerfile.match?(/AS os-packages.*?RUN apt-get update -qq && \\\n\s+apt-get upgrade --with-new-pkgs -y/m)
abort "Dockerfile build stage must inherit the refreshed OS packages" unless dockerfile.include?("FROM os-packages AS build")
abort "Dockerfile runtime stage must inherit the refreshed OS packages" unless dockerfile.include?("FROM os-packages AS runtime")
abort "Running Ruby mismatch: expected #{expected_ruby}, got #{RUBY_VERSION}" unless expected_ruby == RUBY_VERSION

lockfile = File.read(File.join(root, "Gemfile.lock"))
locked_bundler = lockfile[/^BUNDLED WITH\s+([\d.]+)$/m, 1]
abort "Gemfile.lock BUNDLED WITH version is missing" unless locked_bundler
bundler_output, status = Open3.capture2e("bundle", "--version")
abort "Could not determine the running Bundler version" unless status.success?
running_bundler = bundler_output[/Bundler version ([\d.]+)/, 1]
abort "Running Bundler mismatch: lockfile #{locked_bundler}, got #{running_bundler}" unless locked_bundler == running_bundler

puts "Runtime parity passed: Ruby #{expected_ruby}, Bundler #{locked_bundler}, Docker image #{expected_ruby}."
