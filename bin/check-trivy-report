#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "yaml"
require "rubygems"

report_path = ARGV.fetch(0) { abort "Usage: bin/check-trivy-report REPORT.json [IMAGE_GEM_VERSIONS.json]" }
begin
  report = JSON.parse(File.read(report_path))
  raise ArgumentError, "expected Trivy schema version 2 and Results array" unless report.is_a?(Hash) && report["SchemaVersion"] == 2 && report["Results"].is_a?(Array)

  findings = report.fetch("Results").flat_map do |result|
    raise ArgumentError, "invalid result" unless result.is_a?(Hash) && result["Target"].is_a?(String)
    vulnerabilities = result.fetch("Vulnerabilities", [])
    raise ArgumentError, "invalid vulnerabilities" unless vulnerabilities.is_a?(Array)

    vulnerabilities.map do |vulnerability|
      fields = %w[VulnerabilityID PkgName InstalledVersion Severity]
      unless vulnerability.is_a?(Hash) && fields.all? { |field| vulnerability[field].is_a?(String) && !vulnerability[field].empty? } &&
          %w[UNKNOWN LOW MEDIUM HIGH CRITICAL].include?(vulnerability["Severity"]) &&
          (!vulnerability.key?("FixedVersion") || vulnerability["FixedVersion"].is_a?(String))
        raise ArgumentError, "invalid vulnerability"
      end
      [ result, vulnerability ]
    end
  end

  evidence = ARGV[1] && JSON.parse(File.read(ARGV[1]))
  if evidence
    architecture = report.dig("Metadata", "ImageConfig", "architecture")
    unless evidence.is_a?(Hash) && evidence["image"] == report["ArtifactName"] &&
        %w[amd64 arm64].include?(architecture) && evidence["platform"] == "linux/#{architecture}" && evidence["gems"].is_a?(Hash)
      raise ArgumentError, "gem evidence does not match the scanned image and platform"
    end
  end
rescue JSON::ParserError, ArgumentError, TypeError, Errno::ENOENT => error
  abort "Invalid Trivy report or image evidence: #{error.message}"
end

root = File.expand_path("..", __dir__)
exceptions = YAML.safe_load_file(File.join(root, "config/security.yml")).fetch("inactive_default_gem_findings")

actionable, unfixed = findings.select { |_result, finding| %w[HIGH CRITICAL].include?(finding["Severity"]) }
  .partition { |_result, finding| !finding["FixedVersion"].to_s.strip.empty? }
covered_default_gems, blocking = actionable.partition do |result, vulnerability|
  exception = exceptions[vulnerability["VulnerabilityID"]]
  next false unless exception && evidence && result["Class"] == "lang-pkgs" && result["Type"] == "gemspec"
  next false unless vulnerability["PkgName"] == exception.fetch("package") &&
    vulnerability["InstalledVersion"] == exception.fetch("installed_version") &&
    vulnerability["FixedVersion"] == exception.fetch("fixed_version") &&
    vulnerability["PkgPath"].to_s.match?(Regexp.new(exception.fetch("package_path_pattern")))

  loaded = evidence.fetch("gems")[vulnerability["PkgName"]]
  next false unless loaded.is_a?(Hash) && loaded["version"].is_a?(String) && Gem::Version.correct?(loaded["version"]) &&
    loaded["gem_path"].is_a?(String) && !loaded["gem_path"].empty? && loaded["loaded_path"].is_a?(String)
  next false unless loaded["loaded_path"].start_with?("#{loaded['gem_path']}/") &&
    File.basename(loaded["loaded_path"]) == "#{vulnerability['PkgName']}.rb"

  Gem::Version.new(loaded["version"]) >= Gem::Version.new(exception.fetch("minimum_safe_version"))
end
covered_default_gems = covered_default_gems.map(&:last)
blocking = blocking.map(&:last)
unfixed = unfixed.map(&:last)

summary = if blocking.empty?
  message = "Trivy policy passed: no active fixable HIGH or CRITICAL OS/library vulnerabilities."
  if covered_default_gems.any?
    names = covered_default_gems.map { |finding| finding.fetch("PkgName") }.uniq.sort.join(", ")
    message += " Stale bundled default-gem copies covered by verified image runtime versions: #{names}."
  end
  message
else
  details = blocking.group_by { |vulnerability| vulnerability.fetch("PkgName") }.sort.map do |package, findings|
    installed = findings.map { |finding| finding.fetch("InstalledVersion") }.uniq.sort.join(", ")
    fixed = findings.map { |finding| finding.fetch("FixedVersion") }.uniq.sort.join(", ")
    severities = findings.group_by { |finding| finding.fetch("Severity") }
      .sort.map { |severity, matches| "#{matches.size} #{severity}" }.join(", ")
    identifiers = findings.map { |finding| finding.fetch("VulnerabilityID") }.uniq.sort.join(", ")
    "- #{package} #{installed} -> #{fixed}: #{findings.size} finding(s) (#{severities}); #{identifiers}"
  end
  heading = "Trivy policy failed with #{blocking.size} fixable HIGH/CRITICAL finding(s) " \
    "across #{blocking.map { |finding| finding.fetch('PkgName') }.uniq.size} package(s):"
  ([ heading ] + details).join("\n")
end

puts summary
if unfixed.any?
  identifiers = unfixed.map { |finding| finding.fetch("VulnerabilityID") }.uniq.sort.join(", ")
  puts "Non-blocking unfixed HIGH/CRITICAL findings (#{unfixed.size}): #{identifiers}"
end
if (summary_path = ENV["GITHUB_STEP_SUMMARY"])
  File.open(summary_path, "a") do |file|
    file.puts "## Container vulnerability audit"
    file.puts
    file.puts summary
    file.puts
    file.puts "Scope: production image OS packages and bundled application libraries."
    file.puts "Policy: fail on HIGH/CRITICAL findings with a published fixed version; report unfixed findings in Trivy output."
  end
end

exit 1 if blocking.any?
