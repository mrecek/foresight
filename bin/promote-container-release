#!/usr/bin/env bash
set -euo pipefail

image="${1:?Usage: bin/promote-container-release IMAGE DIGEST COMMIT_SHA RELEASE_ID REASON}"
digest="${2:?Digest is required}"
commit_sha="${3:?Commit SHA is required}"
release_id="${4:?Release ID is required}"
reason="${5:?Release reason is required}"

[[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] || { echo "Invalid digest: $digest" >&2; exit 1; }
[[ "$commit_sha" =~ ^[0-9a-f]{40}$ ]] || { echo "Invalid commit SHA: $commit_sha" >&2; exit 1; }
[[ "$release_id" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}-[0-9]+-[0-9]+$ ]] || { echo "Invalid release ID: $release_id" >&2; exit 1; }
[[ "$reason" =~ ^(source|weekly-refresh|security|manual|validation)$ ]] || { echo "Invalid release reason: $reason" >&2; exit 1; }

source_reference="${image}@${digest}"
release_tag="release-${release_id}"

tag_digest() {
  bin/resolve-image-digest "${image}:$1" --allow-missing
}

assert_tag() {
  local tag="$1"
  local actual
  actual="$(tag_digest "$tag")"
  [[ "$actual" == "$digest" ]] || {
    echo "Promotion verification failed: ${image}:${tag} resolved to ${actual:-nothing}, expected ${digest}" >&2
    exit 1
  }
}

existing_release="$(tag_digest "$release_tag")"
if [[ -n "$existing_release" && "$existing_release" != "$digest" ]]; then
  echo "Immutable tag collision: ${image}:${release_tag} is ${existing_release}, expected ${digest}" >&2
  exit 1
fi

default_branch="${GITHUB_DEFAULT_BRANCH:-main}"
repository="${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required}"
head_sha="$(gh api "repos/${repository}/commits/${default_branch}" --jq .sha)"
[[ "$head_sha" == "$commit_sha" ]] || {
  echo "Release is stale: ${default_branch} is ${head_sha}, candidate is ${commit_sha}" >&2
  exit 1
}

bin/check-container-manifest "$source_reference"
bin/check-container-metadata "$source_reference"
gh attestation verify "oci://${source_reference}" \
  --repo "$repository" \
  --signer-workflow "${repository}/.github/workflows/docker.yml" \
  --source-digest "$commit_sha" >/dev/null

if [[ -n "${EXPECTED_PROMOTED_DIGEST:-}" ]]; then
  current="$(tag_digest latest)"
  [[ "$current" == "$EXPECTED_PROMOTED_DIGEST" ]] || {
    echo "Production changed during verification: latest is ${current:-nothing}, expected ${EXPECTED_PROMOTED_DIGEST}" >&2
    exit 1
  }
fi

# Establish the immutable recovery point before moving the production pointer.
if [[ -z "$existing_release" ]]; then
  docker buildx imagetools create --tag "${image}:${release_tag}" "$source_reference"
fi
assert_tag "$release_tag"

current="$(tag_digest latest)"
if [[ "$current" != "$digest" ]]; then
  docker buildx imagetools create --tag "${image}:latest" "$source_reference"
fi
assert_tag latest

echo "Container release promoted: ${image}:${release_tag}@${digest} (${reason})"
