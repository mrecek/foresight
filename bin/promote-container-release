#!/usr/bin/env bash
set -euo pipefail

image="${1:?Usage: bin/promote-container-release IMAGE DIGEST COMMIT_SHA RELEASE_DATE}"
digest="${2:?Digest is required}"
commit_sha="${3:?Commit SHA is required}"
release_date="${4:?Release date is required}"

[[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] || { echo "Invalid digest: $digest" >&2; exit 1; }
[[ "$commit_sha" =~ ^[0-9a-f]{40}$ ]] || { echo "Invalid commit SHA: $commit_sha" >&2; exit 1; }
[[ "$release_date" =~ ^[0-9]{4}\.[0-9]{2}\.[0-9]{2}$ ]] || { echo "Invalid release date: $release_date" >&2; exit 1; }

source_reference="${image}@${digest}"
immutable_tag="${release_date}-${commit_sha:0:7}"
marker_tag="sha-${commit_sha}"

tag_digest() {
  docker buildx imagetools inspect "${image}:$1" --format '{{json .Manifest.Digest}}' 2>/dev/null | tr -d '"'
}

assert_tag() {
  local tag="$1"
  local actual
  actual="$(tag_digest "$tag")"
  [[ "$actual" == "$digest" ]] || {
    echo "Promotion verification failed: ${image}:${tag} resolved to ${actual:-nothing}, expected ${digest}" >&2
    exit 1
  }
}

ensure_immutable() {
  local tag="$1"
  local existing=""
  existing="$(tag_digest "$tag" || true)"
  if [[ -n "$existing" && "$existing" != "$digest" ]]; then
    echo "Immutable tag collision: ${image}:${tag} is ${existing}, expected ${digest}" >&2
    exit 1
  fi
  if [[ -z "$existing" ]]; then
    docker buildx imagetools create --tag "${image}:${tag}" "$source_reference"
  fi
  assert_tag "$tag"
}

ensure_mutable() {
  local tag="$1"
  local existing=""
  existing="$(tag_digest "$tag" || true)"
  if [[ "$existing" != "$digest" ]]; then
    docker buildx imagetools create --tag "${image}:${tag}" "$source_reference"
  fi
  assert_tag "$tag"
}

default_branch="${GITHUB_DEFAULT_BRANCH:-main}"
repository="${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required}"
head_sha="$(gh api "repos/${repository}/commits/${default_branch}" --jq .sha)"
[[ "$head_sha" == "$commit_sha" ]] || {
  echo "Release is stale: ${default_branch} is ${head_sha}, candidate is ${commit_sha}" >&2
  exit 1
}

bin/check-container-manifest "$source_reference"
gh attestation verify "oci://${source_reference}" \
  --repo "$repository" \
  --signer-workflow "${repository}/.github/workflows/docker.yml" \
  --source-digest "$commit_sha" >/dev/null

# Promotion is intentionally ordered. The immutable release is established
# first, mutable channels follow, and the full-SHA completion marker is last.
ensure_immutable "$immutable_tag"
ensure_mutable "$release_date"
ensure_mutable "latest"
ensure_immutable "$marker_tag"

echo "Container release promoted: ${image}:${marker_tag}@${digest}"
