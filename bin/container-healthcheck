#!/usr/bin/env ruby
# frozen_string_literal: true

require "net/http"

begin
  port = ENV.fetch("PORT", "8080")
  response = Net::HTTP.start("127.0.0.1", port, open_timeout: 1, read_timeout: 1) do |http|
    http.get("/up")
  end
  exit(response.is_a?(Net::HTTPSuccess) ? 0 : 1)
rescue StandardError
  exit 1
end
