#!/usr/bin/env ruby

require "json"
require "net/http"
require "optparse"
require "uri"

options = {}
OptionParser.new do |parser|
  parser.on("--refs FILE") { |path| options[:refs] = path }
  parser.on("--github-output FILE") { |path| options[:output] = path }
end.parse!

current = File.read(".ruby-version").strip
match = current.match(/\A(\d+)\.(\d+)\.(\d+)\z/) or abort "Invalid .ruby-version: #{current.inspect}"
major, minor = match.captures.first(2)

payload = if options[:refs]
  File.read(options[:refs])
else
  uri = URI("https://api.github.com/repos/ruby/ruby/git/matching-refs/tags/v#{major}_#{minor}_")
  request = Net::HTTP::Get.new(uri)
  request["Accept"] = "application/vnd.github+json"
  request["X-GitHub-Api-Version"] = "2022-11-28"
  request["Authorization"] = "Bearer #{ENV.fetch('GITHUB_TOKEN')}" if ENV["GITHUB_TOKEN"]
  begin
    response = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true, read_timeout: 20) { |http| http.request(request) }
  rescue StandardError => error
    abort "Ruby upstream request failed: #{error.class}: #{error.message}"
  end
  abort "Ruby upstream request failed: HTTP #{response.code}" unless response.is_a?(Net::HTTPSuccess)
  response.body
end

begin
  refs = JSON.parse(payload)
rescue JSON::ParserError => error
  abort "Ruby upstream returned invalid JSON: #{error.message}"
end
abort "Ruby upstream response must be an array" unless refs.is_a?(Array)
versions = refs.filter_map do |entry|
  tag = entry.fetch("ref", "").delete_prefix("refs/tags/")
  matched = tag.match(/\Av#{major}_#{minor}_(\d+)\z/)
  "#{major}.#{minor}.#{matched[1]}" if matched
end
abort "Ruby upstream returned no final releases for #{major}.#{minor}" if versions.empty?

latest = versions.max_by { |version| version.split(".").map(&:to_i) }
comparison = current.split(".").map(&:to_i) <=> latest.split(".").map(&:to_i)
abort "Configured Ruby #{current} is newer than upstream #{latest}" if comparison.positive?
status = comparison.zero? ? "current" : "stale"

if options[:output]
  File.open(options[:output], "a") do |output|
    output.puts "status=#{status}"
    output.puts "current=#{current}"
    output.puts "latest=#{latest}"
  end
end

puts "Ruby #{current} is #{status}; latest #{major}.#{minor} patch is #{latest}."
