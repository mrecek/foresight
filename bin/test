#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../config/boot"
require "rails/test_unit/runner"
require "minitest"

Dir.chdir(File.expand_path("..", __dir__))
$LOAD_PATH.unshift(File.expand_path("../test", __dir__), File.expand_path("../lib", __dir__))
# The complete contract includes system and standalone process tests.
ENV["DEFAULT_TEST"] = "test/**/*_test.rb"
ENV["DEFAULT_TEST_EXCLUDE"] = "test/{dummy,fixtures}/**/*_test.rb"
Rails::TestUnit::Runner.parse_options(ARGV)
abort "Tests must run in the test environment" unless ENV["RAILS_ENV"] == "test"

module Minitest
  class NonemptyReporter < StatisticsReporter
    def report
      abort "No tests executed; check the selected paths, lines and name filter." if count.zero?
    end
  end

  def self.plugin_foresight_init(options)
    reporter << NonemptyReporter.new(options[:io], options)
  end
end
Minitest.extensions << "foresight"

abort "Test database preparation failed" unless system("bin/rails", "db:test:prepare")
Rails::TestUnit::Runner.run(ARGV)
