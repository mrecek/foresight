#!/usr/bin/env ruby
# frozen_string_literal: true

require "securerandom"

SECRET_KEY_BASE_MIN_BYTES = 30
secret_path = ENV.fetch("SECRET_KEY_BASE_FILE", "/rails/storage/.secret_key_base")

def fail_secret(message)
  warn "Foresight startup error: #{message}"
  exit 1
end

def validate_secret_value(value, source)
  return if value.bytesize >= SECRET_KEY_BASE_MIN_BYTES

  fail_secret "#{source} must contain at least #{SECRET_KEY_BASE_MIN_BYTES} bytes"
end

def load_persisted_secret(path)
  stat = File.lstat(path)
  fail_secret "#{path} must not be a symbolic link" if stat.symlink?
  fail_secret "#{path} must be a regular file" unless stat.file?
  fail_secret "#{path} must be owned by the container user" unless stat.uid == Process.euid
  fail_secret "#{path} must not grant group or other permissions" unless (stat.mode & 0o077).zero?
  fail_secret "#{path} is not readable by the container user" unless File.readable?(path)

  value = File.binread(path).sub(/\n+\z/, "")
  validate_secret_value(value, path)
  value
rescue Errno::ENOENT
  fail_secret "#{path} does not exist"
end

def persist_generated_secret(path)
  directory = File.dirname(path)
  directory_stat = File.lstat(directory)
  fail_secret "#{directory} must not be a symbolic link" if directory_stat.symlink?
  fail_secret "#{directory} does not exist" unless directory_stat.directory?

  generated = SecureRandom.hex(64)
  validate_secret_value(generated, "generated session secret")
  temporary = "#{path}.tmp.#{Process.pid}.#{SecureRandom.hex(8)}"

  begin
    File.open(temporary, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |file|
      file.write("#{generated}\n")
      file.flush
      file.fsync
    end

    begin
      # Publish the complete file only if no concurrent process won first.
      File.link(temporary, path)
      File.open(directory, File::RDONLY, &:fsync)
    rescue Errno::EEXIST
      raise unless File.exist?(path) || File.symlink?(path)
    end
  rescue SystemCallError
    fail_secret "cannot create a private secret in #{directory}"
  ensure
    File.unlink(temporary) if File.exist?(temporary)
  end

  load_persisted_secret(path)
rescue Errno::ENOENT
  fail_secret "#{directory} does not exist"
end

secret = if ENV.key?("SECRET_KEY_BASE")
  ENV.fetch("SECRET_KEY_BASE").tap { |value| validate_secret_value(value, "SECRET_KEY_BASE") }
elsif File.exist?(secret_path) || File.symlink?(secret_path)
  load_persisted_secret(secret_path)
else
  persist_generated_secret(secret_path)
end

ENV["SECRET_KEY_BASE"] = secret

# Create or migrate the database only for the packaged server command.
if ARGV.last(2) == [ "./bin/rails", "server" ]
  exit 1 unless system("./bin/rails", "db:prepare")
end

exec(*ARGV)
