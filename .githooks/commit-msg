#!/usr/bin/env bash
set -euo pipefail

message_file="${1:?commit message path is required}"
subject="$(sed -n '1p' "$message_file")"

case "$subject" in
  Merge\ *|Revert\ *|fixup\!\ *|squash\!\ *) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'
if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  printf '%s\n' \
    "Invalid commit subject: $subject" \
    "Expected Conventional Commits: <type>[(scope)][!]: <summary>" >&2
  exit 1
fi
